<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Infinite Afternoon — endless generative ambient music</title>

    <meta name="description" content="Infinite Afternoon plays endless, ever-changing generative ambient music in your browser. Every note lands at a random moment, so no two listens are ever the same. Inspired by Brian Eno's Thursday Afternoon." />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href="https://infiniteafternoon.com/" />
    <meta property="og:locale" content="en_EN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Infinite Afternoon" />
    @*<meta property="og:image" content="https://erwinvankester.nl/img/erwin/profile.jpg" />*@
    <meta property="og:description" content="Infinite Afternoon gives you always-changing generated ambient music, available on the web." />
    <meta property="og:url" content="https://infiniteafternoon.com/" />
    <meta property="og:site_name" content="Infinite Afternoon" />
    @*<meta name="twitter:card" content="summary_large_image" />*@

    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebApplication",
      "name": "Infinite Afternoon",
      "url": "https://infiniteafternoon.com/",
      "description": "Endless, ever-changing generative ambient music in your browser, inspired by Brian Eno's Thursday Afternoon.",
      "applicationCategory": "MultimediaApplication",
      "genre": "Ambient music",
      "browserRequirements": "Requires JavaScript",
      "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "EUR" },
      "author": { "@@type": "Person", "name": "Erwin van Kester", "url": "https://erwinvankester.nl" }
    }
    </script>

    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#191919" />
    <link rel="apple-touch-icon" href="~/img/icon-192.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/afternoon.css" asp-append-version="true" />
    <style>
    </style>
</head>
<body>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0488N29E87"></script>
    <script>window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-0488N29E87', { 'anonymize_ip': true });</script>

    @RenderBody()

    <a id="tag" href="https://erwinvankester.nl" target="_blank">
        ERWINv<br />
        KESTER
    </a>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>